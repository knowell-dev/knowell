# Copy to .env (git-ignored). Non-secret settings only; put real secrets in deploy/secrets/.
# Provider API keys referenced from config/hub.toml as `env:NAME` may be added here by you.

# Image tag to run (a release version once 1.0 ships).
KNOWELL_IMAGE_TAG=latest

# Where the panel is published on the host. Keep 127.0.0.1 unless a TLS proxy or
# firewall protects the port.
KNOWELL_PANEL_BIND=127.0.0.1
KNOWELL_PANEL_PORT=7420

# Public URL of the hub as clients and browsers reach it. Required when the hub
# listens on all interfaces inside the container (the server only accepts this
# Host/Origin besides loopback). Put a TLS proxy in front for anything but localhost.
KNOWELL_PUBLIC_URL=http://localhost:7420
